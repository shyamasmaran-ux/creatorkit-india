# GROQ_API_KEY: Primary server-side AI provider key for CreatorKit India (Vercel & production).
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENROUTER_API_KEY: Backup server-side free AI provider key (uses verified free models only).
# Get a free API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Used automatically inside Google AI Studio Preview.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
